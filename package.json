{
  "name": "@zigma-ai/zigma-workspace",
  "version": "0.1.0",
  "description": "Zigma workspace management CLI",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/api/index.js"
  },
  "bin": {
    "zigma-workspace": "./dist/cli/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc",
    "check": "npm run typecheck && npm run build && npm run test",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "vitest run",
    "test:smoke": "node dist/cli/index.js --help",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LummiGhost/zigma-workspace.git"
  },
  "homepage": "https://github.com/LummiGhost/zigma-workspace#readme",
  "bugs": {
    "url": "https://github.com/LummiGhost/zigma-workspace/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "commander": "^12.1.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
